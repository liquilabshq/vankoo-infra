# Profile Service
PROFILE_SERVICE_PORT=3000
PROFILE_DB_PORT=5433
PROFILE_DB_NAME=vankoo_profile_db_dev
PROFILE_DB_USER=YOUR_DB_USER
PROFILE_DB_PASSWORD=YOUR_DB_PASSWORD

# IAM Service
IAM_SERVICE_PORT=8081
IAM_SERVICE_HOST=iam-service
JWT_SECRET=WriteHereYourJsonWebTokenSecretSuperSecretForDevelopment
JWT_EXPIRATION_DAYS=7

IAM_DB_HOST=iam-db-postgres
IAM_DB_PORT=5432
IAM_DB_NAME=vankoo_iam_db_dev
IAM_DB_USERNAME=YOUR_DB_USER
IAM_DB_PASSWORD=YOUR_DB_PASSWORD

# Correo saliente. En local lo recoge Mailpit y se lee en http://localhost:8025;
# en producción, MAIL_HOST y MAIL_PORT apuntan a un relay de verdad con credenciales.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=Vankoo <no-reply@vankoo.dev>
PASSWORD_RESET_WEB_URL=http://localhost:5173/iam/reset
PASSWORD_RESET_MOBILE_URL=vankoo://reset-password
PASSWORD_RESET_EXPIRATION_MINUTES=30

IAM_DOCUMENTATION_SERVER_URL=localhost
IAM_DOCUMENTATION_GATEWAY_URL=localhost

# Invoicing Service
INVOICING_DB_NAME=vankoo_invoicing_db_dev
INVOICING_DB_USER=YOUR_DB_USER
INVOICING_DB_PASSWORD=YOUR_DB_PASSWORD
INVOICING_DB_PORT=27017

# Investment Service
INVESTMENT_SERVICE_PORT=8083
INVESTMENT_SERVICE_HOST=investment-service
INVESTMENT_DB_PORT=1521
INVESTMENT_DB_MASTER_PASSWORD=YOUR_DB_MASTER_PASSWORD
INVESTMENT_DB_USER=YOUR_DB_USER
INVESTMENT_DB_PASSWORD=YOUR_DB_PASSWORD

# Finance Service
FINANCE_REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=YOUR_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=YOUR_MINIO_ROOT_PASSWORD
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# Amazon S3 (Profile Service — solo si STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Kafka
KAFKA_HOST=kafka-broker
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=9094
KAFKA_CLUSTER_ID=YOUR_CLUSTER_ID
KAFKA_CLUSTER_NAME=vankoo-dev-cluster
KAFKA_UI_PORT=9000

# Discovery Server
DISCOVERY_SERVER_PORT=8761
DISCOVERY_SERVER_URL=http://discovery-server:8761/eureka/

# API Gateway
API_GATEWAY_PORT=8080