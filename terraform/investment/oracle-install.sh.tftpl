#!/bin/bash
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq docker.io stunnel4
systemctl enable --now docker
install -d -m 700 /etc/vankoo

# Protected extension payload; do not enable shell tracing or print these files.
printf '%s' '${certificate_b64}' | base64 -d > /etc/vankoo/oracle.crt
printf '%s' '${private_key_b64}' | base64 -d > /etc/vankoo/oracle.key
admin_password=$(printf '%s' '${admin_password_b64}' | base64 -d)
app_password=$(printf '%s' '${app_password_b64}' | base64 -d)
printf 'ORACLE_PASSWORD=%s\nAPP_USER=VANKOO_INVESTMENT\nAPP_USER_PASSWORD=%s\n' \
  "$admin_password" "$app_password" > /etc/vankoo/oracle.env
unset admin_password app_password

docker volume create investment-oracle-data >/dev/null
# Re-applying must not recreate the database or silently rotate an existing user's password.
if ! docker container inspect investment-oracle >/dev/null 2>&1; then
  docker run -d --name investment-oracle --restart unless-stopped \
    --env-file /etc/vankoo/oracle.env \
    --publish 127.0.0.1:1521:1521 \
    --mount source=investment-oracle-data,target=/opt/oracle/oradata \
    --health-cmd healthcheck.sh --health-interval 15s --health-timeout 10s \
    --health-start-period 180s --health-retries 20 \
    gvenzl/oracle-free:23.26.3-slim >/dev/null
else
  docker start investment-oracle >/dev/null
fi

cat > /etc/vankoo/oracle-tls.conf <<'CONFIG'
foreground = yes
pid =
sslVersionMin = TLSv1.2
cert = /etc/vankoo/oracle.crt
key = /etc/vankoo/oracle.key
[oracle]
accept = 0.0.0.0:2484
connect = 127.0.0.1:1521
CONFIG
cat > /etc/systemd/system/investment-oracle-tls.service <<'SERVICE'
[Unit]
Description=Investment Oracle TLS endpoint
After=network-online.target docker.service
[Service]
ExecStart=/usr/bin/stunnel4 /etc/vankoo/oracle-tls.conf
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable investment-oracle-tls
systemctl restart investment-oracle-tls

for attempt in $(seq 1 100); do
  if [ "$(docker inspect --format '{{.State.Health.Status}}' investment-oracle)" = healthy ]; then
    echo 'Oracle FREEPDB1 healthy; TLS endpoint prepared.'
    exit 0
  fi
  sleep 10
done
echo 'Oracle did not become healthy. Inspect container logs privately; do not publish credentials.' >&2
exit 1
