{
 "uid": "vankoo-overview",
 "title": "Vankoo · Visión general",
 "tags": [
  "vankoo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Disponibilidad del API (SLO 99 %)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.95
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vankoo:gateway_availability:ratio5m"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Latencia p95 del API (SLO < 1 s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vankoo:gateway_latency_p95:5m"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Peticiones por segundo",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "vankoo:gateway_requests:rate5m"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Pods de Vankoo listos",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_ready{namespace=\"vankoo\",condition=\"true\"})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Peticiones al API por código de estado",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{namespace=\"vankoo\",job=\"api-gateway\"}[5m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Latencia del API (p50 y p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"vankoo\",job=\"api-gateway\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "vankoo:gateway_latency_p95:5m",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU por servicio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"vankoo\",container!=\"\"}[5m]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Memoria por servicio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"vankoo\",container!=\"\"})",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Reinicios en la última hora",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"vankoo\"}[1h]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Réplicas disponibles por Deployment",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_status_replicas_available{namespace=\"vankoo\"}",
     "legendFormat": "{{deployment}}"
    }
   ]
  }
 ]
}